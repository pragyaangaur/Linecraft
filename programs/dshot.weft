; DShot600 motor command transmitter (the digital ESC protocol in drones).
; A frame is 11 throttle bits, 1 telemetry bit and a 4 bit checksum, MSB
; first. The checksum is the XOR of the three nibbles of the first 12 bits,
; which is the CRC with polynomial x^4 + 1, so the CRC unit makes it. One bit
; is 16 ticks: a 1 is high for 12 ticks and a 0 for 6. DIV = clk / 9.6 MHz.
; The host pushes two bytes per frame: the 12 bits and 4 padding bits.
; Pins: the line is SIDE_BASE.
; Config: side-set 1 pin, OUT_RIGHT = 0, AUTOPULL = 1 with PULL_THRESH = 8,
; CRC width 4, polynomial 0x1, on transmitted bits.
.program dshot
.side_set 1
    set pindirs, 1      side 0
.wrap_target
    pull block          side 0          ; wait for a frame
    ctl crc             side 0          ; the checksum starts at 0
    set y, 11           side 0
data:
    out x, 1            side 1 [1]      ; every bit starts high
    jmp !x dzero        side 1 [3]
    jmp dtail           side 1 [5]      ; a 1 stays high for 12 ticks
dzero:
    nop                 side 0 [5]      ; a 0 drops after 6
dtail:
    jmp y-- data        side 0 [3]
    mov osr, crc        side 1          ; first checksum bit: the set-up
    set y, 3            side 1          ; fits inside its high time
    out x, 1            side 1
    jmp !x czero        side 1 [2]
    jmp ctail           side 1 [5]
check:
    out x, 1            side 1 [1]
    jmp !x czero        side 1 [3]
    jmp ctail           side 1 [5]
czero:
    nop                 side 0 [5]
ctail:
    jmp y-- check       side 0 [3]
.wrap
