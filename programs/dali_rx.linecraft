; DALI backward frame receiver (IEC 62386-101): the reply a lamp sends.
; A frame is a start bit, 8 data bits MSB first and two stop bits, in
; Manchester code where a 1 is low then high. One half-bit symbol is 2
; ticks, and the divider resyncs on every edge with SYNC_PHASE chosen so
; the ticks fall at 1/4 and 3/4 of a symbol, as in usb_ls_rx. The built-in
; manchester receive table decodes the symbols. The start bit decodes as a
; 1 like any other bit, and PUSH_THRESH = 9 with IN_RIGHT = 0 pushes only the
; low 8 bits of the ISR, so the start bit falls away with no extra code.
; Pins: the line = IN_BASE = SYNC_PIN.
; Config: IN_RIGHT = 0, AUTOPUSH = 1 with PUSH_THRESH = 9, SYNC_EN = 1,
; line coder manchester (rx), FST_INIT = its first state.
.program dali_rx
.wrap_target
    ctl fst
    mov isr, null
    set y, 17                       ; 18 symbols: the start bit and 8 data bits
    wait 1 pin 0                    ; idle first, so a stale 0 cannot start a frame
    wait 0 pin 0                    ; the start bit's first edge, at 1/4 of a symbol
sym:
    in fst, 1                       ; 3/4 of a symbol
    jmp y-- sym                     ; 1/4 of the next one
.wrap
